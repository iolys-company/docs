{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      { "files": ["index.md", "toc.yml", "navigation/toc.yml", "guide/**.md", "providers/**.md", "customization/**.md", "reference/**.md"] }
    ],
    "resource": [{ "files": ["assets/**", ".nojekyll", "404.html"] }],
    "output": "_site",
    "template": ["default", "modern", "templates/iolys"],
    "globalMetadata": {
      "_appTitle": "iolys documentation",
      "_appName": "iolys",
      "_appLogoPath": "assets/brand/iolys.webp",
      "_appFaviconPath": "assets/brand/favicon.ico",
      "_enableSearch": true,
      "_disableTocFilter": true,
      "_disableContribution": true,
      "_lang": "en",
      "_appFooter": "<span>iolys <span class=\"footer-divider\">/</span> Switch AI providers, not workflows.</span><span class=\"footer-links\"><a href=\"https://getiolys.com\">Website</a><a href=\"https://discord.com/invite/NMnFZmPsc5\">Community</a><a href=\"https://dotnet.github.io/docfx\">Built with DocFX</a></span>"
    },
    "sitemap": { "baseUrl": "https://iolys-company.github.io/docs/" }
  }
}
